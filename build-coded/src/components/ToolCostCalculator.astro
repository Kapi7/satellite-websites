<section class="tool-cost" aria-label="Compare complete drill setup costs">
  <h3>Your prices, your total</h3>
  <p>Enter delivered amounts in the same currency. Blank means unknown; enter 0 when nothing extra is needed.</p>
  <label>Currency <select name="currency"><option value="USD">USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option></select></label>
  <div class="cost-fields">
    <fieldset><legend>Bare-tool route</legend>
      <label>Bare tool, including tax and delivery <input name="bare" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" required /></label>
      <label>Missing battery and charger <input name="power" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" required /></label>
      <label>Other items needed for this route <input name="bareExtras" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" required /></label>
    </fieldset>
    <fieldset><legend>Kit route</legend>
      <label>Kit, including tax and delivery <input name="kit" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" required /></label>
      <label>Other items missing from the kit <input name="kitExtras" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" required /></label>
    </fieldset>
  </div>
  <button type="button">Compare my totals</button>
  <output aria-live="polite">Enter all five amounts to compare. No retailer prices are prefilled.</output>
  <noscript>Without JavaScript: add the three bare-tool amounts, add the two kit amounts, then compare the totals.</noscript>
</section>
<script>
  import { compareToolCosts } from '../utils/tool-cost.mjs';
  document.querySelectorAll<HTMLElement>('.tool-cost').forEach(form => {
    const output = form.querySelector('output')!;
    form.addEventListener('input', () => { output.textContent = 'Amounts changed. Compare again to update the result.'; });
    form.querySelector('button')!.addEventListener('click', event => {
      event.preventDefault();
      const data = new Map(['bare','power','bareExtras','kit','kitExtras','currency'].map(name => [name, form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)!.value]));
      const values = ['bare','power','bareExtras','kit','kitExtras'].map(k => data.get(k) === '' ? NaN : Number(data.get(k)));
      const result = compareToolCosts(values);
      if (!result) { output.textContent = 'Enter valid non-negative amounts in every field.'; return; }
      const money = new Intl.NumberFormat('en-US', {style:'currency',currency:String(data.get('currency'))});
      output.textContent = `Bare-tool setup: ${money.format(result.bare)}. Kit setup: ${money.format(result.kit)}. ` + (result.lower === 'equal' ? 'The totals are equal.' : `The ${result.lower === 'bare' ? 'bare-tool' : 'kit'} route costs ${money.format(result.difference)} less with your inputs.`) + ' Compare suitability and contents before buying.';
    });
  });
</script>
<style>
.tool-cost{margin:28px 0;padding:24px;border:1px solid #ccd1d4;border-radius:12px;background:#fff;color:#17212b}.tool-cost h3{margin:0 0 12px}.tool-cost p{font-size:14px}.cost-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}fieldset{min-width:0;border:0;padding:0;margin:20px 0}legend{font-weight:700}label{display:block;font-size:14px;line-height:1.4;margin:14px 0}input,select{display:block;background:#fff;color:#17212b;border:1px solid #7e8a93;border-radius:6px;width:100%;padding:12px;min-height:48px;font-size:16px;margin-top:6px;box-sizing:border-box}button{background:#17212b;color:white;padding:14px 20px;border-radius:6px;min-height:48px}output{display:block;margin-top:18px;font-size:16px;line-height:1.6}input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid #c85813;outline-offset:2px}@media(max-width:640px){.cost-fields{grid-template-columns:1fr;gap:0}.tool-cost{padding:16px}}
</style>
