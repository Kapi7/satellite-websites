---
import { amazonLink, amazonActive } from '../utils/retailer-links.mjs';
const {slug,locale='en'}=Astro.props;
const show=locale==='en' && ['dewalt-vs-milwaukee-cordless-drill','impact-driver-vs-drill'].includes(slug);
---
{show && <aside class="tool-purchase" aria-label="Compare the exact drill listing">
<img src="/images/verified/dcd800.webp" alt="DeWalt DCD800 drill/driver, manufacturer photo" width="180" height="180" loading="lazy" />
<div><h2>Buying a drill/driver? Check the exact package.</h2>
<p><strong>DeWalt DCD800B — tool only.</strong> This is a drill/driver, not an impact driver or a hammer drill. Compare the listing's model suffix and included items; budget separately for a compatible battery and charger if needed.</p>
<a href={amazonLink('https://www.amazon.com/dp/B09ZQ4VTXK')} rel="sponsored noopener noreferrer" target="_blank" data-retailer="amazon-us" data-product="DCD800B">Check DCD800B on Amazon US →</a>
<p class="note">Check the seller, delivery to your country, final price and warranty terms. The photograph is from the manufacturer; this is a source-based comparison, not a hands-on test.</p>
<p class="note">{amazonActive ? 'As an Amazon Associate I earn from qualifying purchases.' : 'This is an ordinary retailer link. We are not currently claiming Amazon commission on this link.'}</p></div></aside>}
<style>
.tool-purchase{display:grid;grid-template-columns:180px minmax(0,1fr);gap:24px;margin:32px 0;padding:24px;border:1px solid #ccd1d4;border-radius:12px;background:#f7f8f9;color:#17212b}.tool-purchase img{width:180px;height:180px;object-fit:contain;background:#fff;border-radius:8px}h2{font-size:24px;line-height:1.3}p{margin:12px 0;line-height:1.65}a{display:inline-block;background:#17212b;color:white;padding:14px 18px;min-height:48px;border-radius:6px}.note{font-size:13px}a:focus-visible{outline:3px solid #c85813;outline-offset:3px}@media(max-width:600px){.tool-purchase{grid-template-columns:1fr;padding:20px}.tool-purchase img{width:100%;height:190px}}
</style>
