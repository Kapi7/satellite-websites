---
import { amazonLink, amazonActive } from '../utils/retailer-links.mjs';
import products from '../data/amazon-products.json';
import reviewed from '../data/reviewed-drill-guides.json';
const {slug,locale='en'}=Astro.props;
const show=locale==='en' && reviewed.includes(slug);
---
{show && <section id="compare-drill-packages" class="tool-purchase" aria-label="Compare drill packages">
  <p class="eyebrow">Choose the package you need</p>
  <h2>Already have batteries, or starting fresh?</h2>
  <p>These are two packages for the same drill/driver. Neither adds a hammer drill or impact driver. Check the complete cost before choosing.</p>
  <p class="disclosure">{amazonActive ? 'As an Amazon Associate I earn from qualifying purchases.' : 'Retailer references; no Amazon commission is currently claimed.'}{' '}<a href="/disclosure/">How we choose and disclose links</a>.</p>
  <div class="packages">{products.map(product => <article class="package">
    <img src={product.image} alt={`${product.name}, manufacturer product photo`} width="360" height="270" loading="lazy" />
    <p class="fit">{product.fit}</p>
    <h3>{product.name}</h3>
    <p>{product.contents}</p>
    <p class="note">{product.skip}</p>
    <a class="buy" href={amazonLink(`https://www.amazon.com/dp/${product.asin}`)} rel="sponsored noopener noreferrer" target="_blank" data-retailer="amazon-us" data-product={product.model} data-placement="package-card">Check {product.model} on Amazon US <span aria-hidden="true">↗</span></a>
    <p class="note"><a href={product.manufacturer} rel="noopener noreferrer">Manufacturer specifications &amp; photo source</a></p>
  </article>)}</div>
  <p class="note">Models and package contents checked 2 October 2026. Confirm the current seller, condition, delivery, charger suitability, final price, returns and warranty terms. No live price or stock claim. Manufacturer photography; no hands-on test claimed.</p>
</section>}
<style>
.tool-purchase{scroll-margin-top:90px;margin:32px 0;padding:clamp(16px,3vw,28px);border:1px solid #ccd1d4;border-radius:14px;background:#f6f7f8;color:#17212b}.eyebrow{font-size:11px;letter-spacing:.13em;text-transform:uppercase;font-weight:700;color:#814211}.tool-purchase h2{font-size:clamp(23px,4vw,30px);line-height:1.25;margin:8px 0 16px}.tool-purchase p{line-height:1.65;margin:12px 0}.disclosure,.note{font-size:13px}.disclosure a,.note a{text-decoration:underline;text-underline-offset:3px}.packages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:20px 0}.package{background:#fff;padding:20px;border:1px solid #d9dfe2;border-radius:10px;display:flex;flex-direction:column;min-width:0}.package img{width:100%;height:210px;object-fit:contain;background:#fff}.package h3{font-size:21px;line-height:1.3;margin:4px 0}.fit{font-weight:650;font-size:14px}.buy{display:block;text-align:center;background:#17212b;color:#fff;padding:14px 12px;min-height:48px;border-radius:6px;font-weight:650;margin-top:auto;font-size:14px}.buy:hover{background:#364650}a:focus-visible{outline:3px solid #c85813;outline-offset:3px}@media(max-width:640px){.packages{grid-template-columns:1fr}.package{padding:16px}.package img{height:200px}}
</style>
