---
import miraiEdit from '../../data/mirai-edit.json';
import { localePath } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import { locales, defaultLocale, type Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.map(l => ({
    params: { locale: l === defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const products = miraiEdit;
const schema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'The Edit — curated K-Beauty picks via Mirai Skin',
  description: 'Compare exact TIRTIR, Torriden and Anua products, read the buying guides, and check current Mirai listings.',
});
---

<Base
  title="Mirai Skin Buying Guides: TIRTIR, Torriden & Anua"
  description="Choose a TIRTIR cushion shade, compare lip-care formats or check an Anua moisturizer formula before buying the exact product at Mirai Skin."
  jsonLd={[schema]}
  locale={locale}
>
  <Header locale={locale} mobileTitle="THE EDIT" />

  <main class="gcd-shop">
    <div class="gcd-shop-head">
      <div class="gcd-kicker">
        <span class="pill">MIRAI &times;</span>
        <span class="pill">K-BEAUTY</span>
        <span>Choose with context</span>
      </div>
      <h1>The <em>Edit</em>.</h1>
      <p class="sub">A good purchase starts with the right shade, formula and format. Read the relevant guide, then check the exact product at Mirai Skin. We may earn a commission from purchases through these links. These are source-based guides, not hands-on product tests.</p>
    </div>

    <div class="gcd-shop-grid">
      {products.map((p) => (
        <div class="gcd-shop-card" id={p.slug}>
          <div class="img">

            <img src={p.image} alt={p.name} loading="lazy" />
          </div>
          <div class="body">
            <div class="brand">{p.brand}</div>
            <h3>{p.name}</h3>
            <p class="decision">{p.question}</p><p class="type">{p.check}</p>
            <div class="foot">

              <a class="guide-link" href={localePath(`/${p.guide}/`, p.guideLocales === 'en' ? 'en' : locale)}>Read the buying guide{p.guideLocales === 'en' && locale !== 'en' ? ' (English)' : ''} &rarr;</a>
              <a class="mirai-link" href={p.url} target="_blank" rel="sponsored noopener noreferrer" data-mirai-placement="buying-hub">Check options &amp; price at Mirai &rarr;</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <section class="purchase-check"><h2>Before you order</h2><p>Confirm the exact name, size, shade or variant, current stock, delivery destination, total checkout cost and return conditions at Mirai. If you are still unsure about the shade or formula, use the guide first. You do not need to buy a replacement for a product that already suits you.</p><p>Product photographs are from the linked Mirai listings. Availability was checked on 22 September 2026 and can change.</p></section>
  </main>

  <Footer locale={locale} />
  <BackToTop />
</Base>

<style>
.gcd-shop-card .foot { flex-direction:column;gap:12px;letter-spacing:0;text-transform:none;font-family:inherit;font-size:15px; }
.gcd-shop-card .decision {font-weight:600;margin:8px 0 0;}
.guide-link,.mirai-link {display:block;padding:12px;border:1px solid currentColor;border-radius:4px;line-height:1.4;text-align:center;}
.mirai-link {background:var(--color-charcoal);color:var(--color-cream);}
a:focus-visible {outline:3px solid var(--color-rose-500);outline-offset:3px;}
.purchase-check {max-width:760px;margin:40px 0;line-height:1.7;}
.purchase-check h2 {font-size:28px;}
</style>
