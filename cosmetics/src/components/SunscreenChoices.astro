---
import choices from '../data/sunscreen-choices.json';
import labels from '../data/purchase-labels.json';
import orderInformation from '../data/order-information.json';
import { localePath } from '../i18n/utils';
const {slug,locale} = Astro.props as {slug:string;locale:keyof typeof choices.locales};
const copy = choices.locales[locale];
const order = orderInformation[locale];
function attributed(raw:string) {
  const url = new URL(raw);
  const tags = {utm_source:'glow-coded.com',utm_medium:'affiliate',utm_campaign:'mirai_skin',utm_content:localePath(`/${slug}/`,locale)};
  for (const [key,value] of Object.entries(tags)) if (!url.searchParams.has(key)) url.searchParams.set(key,value);
  return url.href;
}
---
<aside id="mirai-purchase" class="sunscreen-choices" aria-labelledby="formula-choice-heading">
  <p class="brand">Beauty of Joseon</p>
  <h2 id="formula-choice-heading">{copy.heading}</h2>
  <p>{copy.intro}</p>
  <div class="formula-grid">
    {choices.products.map(product => <section class="formula-card" data-formula={product.key}>
      <img src={product.image} alt={product.name} width="180" height="200" loading="lazy" decoding="async" />
      <h3>{product.name}</h3>
      <p>{copy[product.key as 'aqua'|'original']}</p>
      <a class="product-button" href={attributed(product.url)} target="_blank" rel="sponsored noopener noreferrer" data-mirai-placement="article-product">{copy.button} &rarr;</a>
    </section>)}
  </div>
  <p class="note">{copy.verified}</p>
  <p class="note">{order[2]}</p>
  <div class="order-links"><a href={attributed('https://mirai-skin.com/policies/shipping-policy')} target="_blank" rel="sponsored noopener noreferrer">{order[0]}</a><a href={attributed('https://mirai-skin.com/policies/refund-policy')} target="_blank" rel="sponsored noopener noreferrer">{order[1]}</a></div>
  <p class="note">{labels[locale][6]}</p>
</aside>
<style>
.sunscreen-choices{margin:32px 0;padding:24px;border:1px solid #d9bcb0;border-radius:12px;background:#fff8f4;color:#25201d;scroll-margin-top:90px;}
.brand{font-size:12px;letter-spacing:.08em;text-transform:uppercase;}h2{font-size:24px;line-height:1.3;margin:6px 0 14px;}p{font-size:16px;line-height:1.65;margin:10px 0;}
.formula-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:24px 0;}.formula-card{display:flex;flex-direction:column;min-width:0;padding:18px;background:white;border:1px solid #e5d7cf;border-radius:8px;}
img{width:100%;height:200px;object-fit:contain;}h3{font-size:18px;line-height:1.5;margin:16px 0 6px;}.formula-card p{flex:1;}
.product-button{display:block;margin:16px 0 0;padding:14px 16px;min-height:48px;box-sizing:border-box;border-radius:6px;background:#25201d;color:#fff;text-align:center;font-size:16px;line-height:1.45;}.note{font-size:13px;}
.order-links{display:flex;flex-wrap:wrap;gap:4px 16px;}.order-links a{padding:10px 0;min-height:44px;box-sizing:border-box;text-decoration:underline;font-size:14px;}a:focus-visible{outline:3px solid #ab4831;outline-offset:3px;}
@media(max-width:650px){.formula-grid{grid-template-columns:minmax(0,1fr);}.sunscreen-choices{padding:20px;}h2{font-size:23px;}}
</style>
